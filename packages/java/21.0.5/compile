#!/bin/bash

# The entrypoint and any helper classes arrive without an extension, so give
# them a .java suffix. Files that already have an extension are left alone:
# .java sources compile as-is, and data files (data.csv, input.txt) stay put
# so the program can read them at runtime.
for file in "$@"; do
    [[ "$file" == *.* ]] || mv "$file" "$file.java"
done

javac *.java
